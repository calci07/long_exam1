rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validProfile() {
        let p = request.resource.data;
        return p.keys().hasAll(['fName', 'lName', 'age', 'contactNo', 'username', 'emailAddress'])
          && p.keys().hasOnly(['fName', 'lName', 'age', 'contactNo', 'username', 'emailAddress'])
          && p.fName is string && p.fName.size() > 0 && p.fName.size() <= 80
          && p.lName is string && p.lName.size() > 0 && p.lName.size() <= 80
          && p.age is int && p.age >= 1 && p.age <= 150
          && p.contactNo is string && p.contactNo.size() >= 7 && p.contactNo.size() <= 20
          && p.username is string && p.username.matches('^[a-zA-Z0-9_.]{3,30}$')
          && p.emailAddress == request.auth.token.email;
      }
      // The course chat directory lists registered profiles to signed-in users.
      allow read: if request.auth != null;
      allow delete: if owner();
      allow create: if owner() && validProfile();
      allow update: if owner() && validProfile()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username']);
    }

    match /chat_rooms/{roomId} {
      function member() {
        return request.auth != null && request.auth.uid in resource.data.members;
      }
      allow read: if member();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['members'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] is string
        && request.resource.data.members[1] is string
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && roomId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && exists(/databases/$(database)/documents/users/$(request.resource.data.members[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.members[1]));
      allow update: if member() && request.resource.data == resource.data;

      match /messages/{messageId} {
        function participants() {
          return get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.members;
        }
        function receiptValid(field) {
          return request.resource.data[field] == resource.data[field]
            || (resource.data[field] == null && request.resource.data[field] == request.time);
        }
        allow read: if request.auth != null && request.auth.uid in participants();
        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['senderId','senderEmail','receiverId','message','timestamp','deliveredAt','seenAt'])
          && request.resource.data.keys().hasOnly(['senderId','senderEmail','receiverId','message','timestamp','deliveredAt','seenAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderEmail == request.auth.token.email
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.senderId in getAfter(/databases/$(database)/documents/chat_rooms/$(roomId)).data.members
          && request.resource.data.receiverId in getAfter(/databases/$(database)/documents/chat_rooms/$(roomId)).data.members
          && exists(/databases/$(database)/documents/users/$(request.resource.data.receiverId))
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 4000
          && request.resource.data.timestamp == request.time
          && request.resource.data.deliveredAt == null
          && request.resource.data.seenAt == null;
        allow update: if request.auth != null
          && request.auth.uid == resource.data.receiverId
          && request.auth.uid in participants()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredAt','seenAt'])
          && receiptValid('deliveredAt') && receiptValid('seenAt')
          && (request.resource.data.seenAt == null || request.resource.data.deliveredAt != null);
      }
    }
  }
}
